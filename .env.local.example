# Copy this file to .env.local and fill in the values. .env.local is ignored by git
# (the `.env*.local` rule in .gitignore); this example file is the one that is committed.
# Never put a real value in this file.

# SonarCloud user token, used to read the project's issues, quality gate and coverage from
# the SonarCloud API: https://sonarcloud.io -> My Account -> Security -> Generate Tokens.
# The token is shown once, so copy it straight away. Write it with no quotes and no spaces.
#
# This local copy is for reading results. CI uses its own repository secret of the same name
# (GitHub -> Settings -> Secrets and variables -> Actions, or `gh secret set SONAR_TOKEN`);
# the two do not share a value automatically.
SONAR_TOKEN=your-sonarcloud-token-here

# SonarCloud server. Leave as is unless you use a self-hosted SonarQube.
SONAR_HOST_URL=https://sonarcloud.io

# Project identifiers are not secrets and live in sonar-project.properties:
#   sonar.projectKey=RogerioDoCarmo_offline-detector
#   sonar.organization=rogeriodocarmo
