{
  "name": "@rogeriodocarmo/offline-detector-native",
  "version": "0.0.0",
  "description": "offline-detector: native package.",
  "license": "MIT",
  "author": "Rogério do Carmo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RogerioDoCarmo/offline-detector.git",
    "directory": "packages/native"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rogeriodocarmo/offline-detector-core": "workspace:*",
    "@rogeriodocarmo/offline-detector-react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "@react-native-community/netinfo": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    }
  }
}
