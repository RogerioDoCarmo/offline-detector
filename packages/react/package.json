{
  "name": "@rogeriodocarmo/offline-detector-react",
  "version": "0.1.0",
  "description": "offline-detector: react package.",
  "license": "MIT",
  "author": "Rogério do Carmo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RogerioDoCarmo/offline-detector.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rogeriodocarmo/offline-detector-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.10.2",
    "jest-environment-jsdom": "^30.5.2",
    "react-dom": "^19.3.0",
    "react-test-renderer": "^19.3.0"
  }
}
